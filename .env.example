# ===== 模型 Provider 配置 =====
# 支持: deepseek / qwen / ollama / openai / any-openai-compatible
AGENT_LLM_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen 通义千问 (阿里云百炼)
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Ollama 本地 (无需 Key)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 任意 OpenAI 兼容服务
OPENAI_COMPAT_BASE_URL=https://your-endpoint/v1
OPENAI_COMPAT_API_KEY=sk-xxx
OPENAI_COMPAT_MODEL=your-model

# ===== 智能体配置 =====
# 0 = 不设步骤上限(默认)。复杂任务(计划 >5 步 / 多轮工具探索)常在 10 轮内打不完,
# 旧默认 10 会让前端看到"无法完成任务:已尝试 10 步"。设 >0 则在该轮数强制中止。
# 不设上限时由三重收敛机制兜底防死循环:同参 3 连败 / 重新规划耗尽 / 连续空答案。
AGENT_MAX_STEPS=0
AGENT_TEMPERATURE=0.7
AGENT_SYSTEM_PROMPT=你是一个智能助手,请用中文回答。

# ===== LLM 调用可靠性(重试 + 故障转移) =====
# LLM 调用失败(网络/限流/5xx 等瞬态错误)自动重试次数;0 = 不重试
AGENT_LLM_RETRIES=2
# 重试基础延迟(秒),按 2^n 指数退避
AGENT_LLM_RETRY_DELAY=0.5
# 故障转移:主 provider 重试耗尽后自动切换到备用 provider(留空 = 不切换)
AGENT_LLM_FAILOVER_PROVIDER=
# 备用 provider 使用的模型(留空 = 该 provider 默认模型)
AGENT_LLM_FAILOVER_MODEL=

# ===== Provider 熔断(连续失败快速跳过) =====
# 同一 provider 连续失败达到阈值后进入冷却窗口,期间直接跳过该 provider,
# 不再对故障上游反复发请求等待超时(0 = 关闭熔断)
AGENT_LLM_CIRCUIT_THRESHOLD=3
# 熔断冷却时间(秒),冷却结束后计数清零并恢复尝试
AGENT_LLM_CIRCUIT_COOLDOWN=60

# ===== Prompt 缓存控制 =====
# 在 system 消息注入 cache_control 断点,保持稳定前缀命中厂商自动缓存,
# 降本降延迟(DeepSeek/Qwen 等均支持自动前缀缓存)
AGENT_PROMPT_CACHE=true

# ===== Reasoning 模型适配 =====
# 解析 deepseek-reasoner / o1 等推理模型的 reasoning_content 思维链,
# 透出为 thinking 事件而不是混入正文
AGENT_REASONING_ENABLED=true

# ===== 反思循环(Reflexion 式自评→重写) =====
# 最终回答前先用 LLM 按结构化 schema 自评,不合格且有预算则回灌评语要求重写
AGENT_REFLECT=true
# 自评→重写最多轮数(每轮多一次 LLM 调用)
AGENT_REFLECT_MAX_ROUNDS=1
# critic/executor 双角色:评审用独立模型(区别于执行模型),避免自评偏袒。
# provider 留空 = 复用执行模型自评
AGENT_CRITIC_PROVIDER=
AGENT_CRITIC_MODEL=

# ===== 最终答案事实校验(LLM-as-judge) =====
# finalize 产出答案后,用评审模型交叉核对"答案中的断言 vs 工具结果",
# 发现幻觉/未支撑断言时重写一次答案再返回(多一次 LLM 调用)
AGENT_VERIFY=true

# ===== 工具结果去重缓存 =====
# 同一运行内,相同工具+相同参数的调用直接复用上一次成功结果,
# 避免重复执行昂贵/确定性调用(对齐 Claude Code tool result caching)。
# 0 = 关闭
AGENT_TOOL_CACHE_SIZE=50

# ===== 计划失败重规划(replan-on-failure) =====
# 同一工具连续失败达阈值时,基于失败原因生成修订版计划替换旧计划
AGENT_REPLAN_ENABLED=true
AGENT_REPLAN_AFTER_FAILURES=2
AGENT_REPLAN_MAX_TIMES=2

# ===== 图运行时 / Checkpoint(可持久化执行) =====
# 运行时为自研零依赖 Graph/DAG 编排(节点:prepare->llm->tools/finalize),
# 支持并行分支与合流;每节点执行完把完整状态(消息/计划/步骤/路由)落盘
# data/checkpoints.db,支持断点续跑 / 后台任务 / 运行记录查询
AGENT_CHECKPOINT_ENABLED=true
# 运行最大图节点数(兜底防死循环;llm 轮数上限仍由 AGENT_MAX_STEPS 控制)
AGENT_GRAPH_MAX_ITERS=300

# Token 级上下文预算(0 = 关闭,沿用字符预算 context_char_budget;>0 时用
# 启发式 estimate_tokens 精确裁剪:中文≈1 token/字,ASCII≈4 字符/token)
# 超预算触发三层压缩:最近消息原文保留 + 中段抽结构化关键事实 + 最早合并摘要
AGENT_TOKEN_BUDGET=0
# 子任务独立上下文强制化:delegate/handoff 子智能体的上下文预算(字符),
# 只拿到指令+背景+工具结果,不回流父级历史
AGENT_SUBAGENT_CONTEXT_BUDGET=60000

# ===== Embedding(真实语义向量) =====
# 切换后端会导致向量维度/语义变化,建议切换后清空知识库重新上传
EMBEDDING_BACKEND=local          # local=哈希嵌入(零依赖)/ api=OpenAI 兼容 Embeddings API
# API 嵌入独立配置(留空则回退 openai_compat / 当前 LLM provider)
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=             # 如 text-embedding-3-small / gte-qwen2-1.5b-instruct
EMBEDDING_BATCH_SIZE=16          # 每次请求最大输入条数(自动分批)
EMBEDDING_RETRIES=2              # 瞬态错误重试次数
EMBEDDING_NORMALIZE=true         # L2 归一化(余弦/faiss 需要)

# ===== ANN 向量索引 =====
VECTOR_INDEX_BACKEND=auto        # auto=装了faiss用faiss否则回退 / flat=faiss精确 / hnsw=faiss近似 / off=纯线性
HNSW_M=16                        # HNSW 图邻居数
HNSW_EF_CONSTRUCTION=200         # 构建搜索范围(越大越准越慢)
HNSW_EF_SEARCH=64                # 查询搜索范围(越大越准越慢)

# ===== 重排 =====
RERANK_MODE=rrf                  # none=不重排 / rrf=向量+关键词RRF融合(默认,零依赖) / api=调用外部Rerank API
RERANK_API_BASE_URL=             # 如 dashscope gte-rerank / Jina Reranker
RERANK_API_KEY=
RERANK_API_MODEL=
RERANK_TOP_N=10                  # 送入重排的最大候选数

# 原生 function calling(工具参数结构化、支持并行调用;失败自动降级为 JSON 文本解析)
AGENT_NATIVE_TOOLS=true

# 长期记忆(对话前自动检索相关记忆注入上下文)
AGENT_MEMORY_ENABLED=true
# 每轮对话后自动抽取事实存入记忆(多一次 LLM 调用,默认关闭)
AGENT_AUTO_MEMORY=false

# 会话摘要压缩:历史超预算时用 LLM 压缩旧消息,而非粗暴截断
AGENT_SUMMARIZE=true
AGENT_SUMMARY_THRESHOLD_RATIO=0.6
AGENT_SUMMARY_CHARS=60000

# 模型路由:简单问答走便宜模型,复杂分析走强模型(留空=用主 provider)
AGENT_ROUTING_ENABLED=false
ROUTER_FAST_PROVIDER=
ROUTER_FAST_MODEL=
ROUTER_STRONG_PROVIDER=
ROUTER_STRONG_MODEL=

# 工具路由:对话前由 LLM 从全量工具里预选相关子集再注入,
# 避免 100+ 工具全量注入导致调用精度下降;路由失败自动回退全量工具
AGENT_TOOL_ROUTER_ENABLED=true
# 预选工具数上限(系统工具 set_plan/update_plan/memory_* 常驻不计入)
AGENT_TOOL_ROUTER_MAX_TOOLS=10

# ===== 可观测性 =====
# 记录 trace(JSONL 文件 + 内存缓冲),/v1/traces 查询、token/成本统计
AGENT_TRACING_ENABLED=true
# 可选:OTLP 导出端点(Langfuse / OpenTelemetry Collector / 自建网关)。
# 配置后事件同步转发到外部平台;留空仅本地记录。端点不可达自动禁用。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 是否导出 LLM 调用细节(token/成本/工具数),大流量时可关
OTEL_EXPORT_LLM_DETAILS=true

# ===== 安全 =====
# 非空时所有 API 需携带 Authorization: Bearer <key>(桌面本地部署默认留空)
AGENT_API_KEY=
# 开启后,危险工具(run_terminal/run_code)需请求 approve_tools 字段获批才执行
AGENT_TOOL_CONFIRM=false
# 危险工具清单(逗号分隔)
AGENT_DANGEROUS_TOOLS=run_terminal,run_code
# 危险工具改为 interrupt 式确认(非阻塞):命中后图引擎暂停并持久化确认请求,
# 调用方先收到 confirmation 事件/响应 interrupt 字段,再经 POST /v1/chat/resume 批准
# 或拒绝后从原节点恢复执行。false 时保留旧的轮询阻塞式确认
AGENT_CONFIRM_INTERRUPT=true
# 输入/输出 Guardrail(Prompt 注入、敏感路径越权、密钥泄漏、系统提示词泄露检测)。
# 命中输入护栏时直接拦截回答;命中输出护栏时用脱敏文本替换再返回
AGENT_GUARDRAILS_ENABLED=true
# 禁止输出的敏感词列表(逗号分隔),用于额外过滤
GUARDRAIL_BLOCKED_TERMS=

# ===== 服务配置 =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8080

# ===== 多模态 =====
# 视觉:开启后,聊天附件里的图片以 image_url content part 进主链路;
# 模型不支持视觉时自动降级为文本提示(不静默丢图)
MULTIMODAL_VISION_ENABLED=true
# 语音转录(ASR)预留入口:OpenAI 兼容 /audio/transcriptions 端点。
# 未配置时语音附件返回引导提示,不影响文本对话
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=                    # 如 whisper-1 / paraformer-realtime-v2
ASR_TIMEOUT=120
# 文字转语音(TTS):OpenAI 兼容 /audio/speech 端点。留空=不启用
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ===== 搜索服务 =====
# 付费搜索 Provider(serpapi/serper/bing),留空则使用 DuckDuckGo 免费回退
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=
# Serper 专用(如使用 serper)
SERPER_API_KEY=
# Bing 专用
BING_API_KEY=

# ===== 后台任务(长期自主运行) =====
# 开启后可通过 POST /v1/tasks 创建后台持续运行的 Agent 任务,独立于请求执行,
# 支持计划-执行-验证循环;GET /v1/tasks/{id}/events 订阅进度(SSE),
# 完成后把答案写入目标会话(主动汇报)
AGENT_BACKGROUND_TASKS=true
# 单个后台任务最长运行时长(分钟),超过自动终止
AGENT_TASK_MAX_MINUTES=60

# ===== 上下文配额硬控制 =====
# 请求级 max_output_tokens 默认上限;0 = 不限制(超过截断并附提示)
AGENT_DEFAULT_MAX_OUTPUT_TOKENS=0

# ===== 语义记忆分层 =====
# 开启后记忆注入分 working(即时)/ semantic(语义检索)/ episodic(会话情节)三层
AGENT_LAYERED_MEMORY=true

# ===== 数据层后端 =====
# 会话/记忆存储:sqlite(默认,零依赖) / redis(需redis-py且REDIS_URL可连接)
STORAGE_BACKEND=sqlite
REDIS_URL=
# 向量存储:auto(装了psycopg且配PGVECTOR才用pgvector,否则SQLite+faiss)
#        / pgvector(强制pgvector) / sqlite
VECTOR_STORE_BACKEND=auto
PGVECTOR_CLIENT_DSN=
PGVECTOR_CLIENT_TABLE=knowledge_vectors

# ===== 代码级自愈 =====
# run_code/run_terminal 失败时自动进入"分析-修复-重跑"闭环(LLM 生成 patch),
# 修复后重跑原命令验证;不自愈则回退到反思提示
AGENT_CODE_SELF_HEAL=true
AGENT_CODE_HEAL_ROUNDS=2
