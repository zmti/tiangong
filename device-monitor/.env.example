# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 数据库配置 (MySQL)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=device_monitor

# 数据库配置 (PostgreSQL) - 可选
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=device_monitor

# 告警配置
ALERT_EMAIL=alert@example.com
ALERT_THRESHOLD_TEMP=80
ALERT_THRESHOLD_CPU=90

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
